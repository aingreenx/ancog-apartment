# Copy to .env.local and fill in. For local dev, run `npm run db:start` (or `npx supabase status`)
# and use API_URL and ANON_KEY from its output.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only, never NEXT_PUBLIC_. Used after checking the caller is an admin (creating
# tenant logins). Local: SERVICE_ROLE_KEY from `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=
