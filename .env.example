# Copy to .env.local and fill in. For local dev, run `npm run db:start` (or `npx supabase status`)
# and use API_URL and ANON_KEY from its output.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only, never NEXT_PUBLIC_. Used after checking the caller is an admin (creating
# tenant logins). Local: SERVICE_ROLE_KEY from `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# Web push (#24). Generate once per environment:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared with the database so its scheduled job can ask the app to send pushes.
PUSH_DISPATCH_SECRET=
